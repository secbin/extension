{
  "name": "securebin: Powerful Pastebin Tool",
  "description": "Securely encrypt your text on Pastebin.com",
  "version": "2.0.2",
  "manifest_version": 3,
  "action": {
    "default_title": "Open securebin"
  },
  "icons": {
    "16": "icons/logo48.png",
    "48": "icons/logo48.png",
    "128": "icons/logo128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "clipboardRead",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://pastebin.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
