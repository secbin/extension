{
  "name": "secureBin",
  "description": "Securely encrypt your text on Pastebin.com",
  "version": "1.0.2",
  "manifest_version": 3,
  "action": {
    "default_title": "Open SecureBin"
  },
  "icons": {
    "16": "logo48.png",
    "48": "logo48.png",
    "128": "logo128.png"
  },
  "background": {
    "service_worker": "./static/js/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["static/js/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "static/js/content.js",
        "securebinlogo.svg",
        "securebinlogo_dark.svg",
        "logo48.png",
        "logo128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": [
    "storage",
    "contextMenus",
    "clipboardWrite",
    "scripting",
    "activeTab",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"]
}
