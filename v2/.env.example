# Copy to .env.local (gitignored) before building.
#
# Bundled default Pastebin developer key. Baked into the built extension at
# build time so users can post without configuring their own key, but kept out
# of the open-source tree. Leave empty to build without a default key (posting
# then requires the user to enter a key in Settings → API Key).
VITE_DEFAULT_PASTEBIN_API_KEY=
